#!/usr/bin/env python3
"""Build the project's local identifier index: salted hashes, never plaintext.

Usage: method-identifier-index [--data-root PATH]

Scans data files under data_root (from .methodsmith/config.local.yaml, or
--data-root): CSV/TSV/PSV with the standard library, Parquet/Feather/Arrow when
pyarrow is installed. Only identifier-like columns are read, chosen by header:
names, MRN/medical record, patient/member/subscriber/record IDs, claim numbers,
SSN, date of birth, address, phone, and email.

Stored entries are normalized values (lowercase, accents folded, split into
alphanumeric tokens): the full value; first+last bigrams for name columns; and,
for ID columns only, single tokens with a digit and at least 4 characters. A
single word is never stored, so common words and surnames alone cannot match.

Output: .methodsmith/identifier-index.local.json with a fresh random salt
and truncated SHA-256 hashes (gitignored, mode 0600). Prints counts only.
"""

import csv
import gzip
import json
import os
import re
import secrets
import subprocess
import sys

# --- identifier index: patterns, normalize, hash, lookup (keep identical across plugin scripts; tested) ---
HASH_WIDTH = 16
# Identifier shapes. Keyword-anchored where digits alone are ambiguous.
IDENTIFIER_PATTERNS = (
    ("an SSN", re.compile(r"(?<!\d)\d{3}-\d{2}-\d{4}(?!\d)")),
    ("an email address", re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}")),
    ("a phone number", re.compile(r"(?<![\d/.])(?:\+?1[-. ]?)?(?:\(\d{3}\)\s?|\d{3}[-. ])\d{3}[-. ]\d{4}(?![\d/])")),
    ("a record identifier", re.compile(
        r"\b(?:mrn|medical[\s_-]*record(?:[\s_-]*(?:number|num|no|#))?|patient[\s_-]*(?:id|identifier|number|no)|"
        r"member[\s_-]*(?:id|number|no)|subscriber[\s_-]*id|claim[\s_-]*(?:number|num|no|id|#)|encounter[\s_-]*id)"
        r"[\s:=#._-]{0,4}[A-Za-z]{0,6}\d{4,}", re.IGNORECASE)),
    ("a date of birth", re.compile(
        r"\b(?:dob|d\.o\.b\.?|date[\s_-]*of[\s_-]*birth|birth[\s_-]*date)\b[\s:=#-]{0,4}"
        r"\d{1,4}[-/.]\d{1,2}[-/.]\d{1,4}", re.IGNORECASE)),
)

# Identifier-like column headings, by kind.
HEADER_KINDS = (
    ("email", re.compile(r"^(?:.*_)?e_?mail(?:_.*)?$")),
    ("phone", re.compile(r"^(?:.*_)?(?:phone|telephone|tel|mobile|cell)(?:_.*)?$")),
    ("first", re.compile(r"^(?:first|given|fore)_?name$|^(?:first|given|fname|forename)$")),
    ("last", re.compile(r"^(?:last|family|sur|maiden)_?name$|^(?:last|surname|family|lname)$")),
    ("name", re.compile(r"^(?:(?:patient|pt|member|subscriber|person|full|middle|preferred)_?)?name$")),
    ("id", re.compile(r"^(?:mrn|medical_?record(?:_.*)?|ssn|social_?security(?:_.*)?|claim|subscriber"
                      r"|(?:patient|pt|person|member|subscriber|record|encounter|enrollee|beneficiary)_?(?:id|num|number|no|nbr)"
                      r"|claim_?(?:id|num|number|no|nbr))$")),
    ("dob", re.compile(r"^(?:dob|birth_?date|date_?of_?birth|birth_?dt|birthday|dt_?birth)$")),
    ("address", re.compile(r"^(?:.*_)?(?:address|addr|street)(?:_.*)?$")),
)


def header_kind(name):
    key = re.sub(r"[^a-z0-9]+", "_", str(name).strip().lower()).strip("_")
    for kind, pattern in HEADER_KINDS:
        if pattern.match(key):
            return kind
    return None


def id_tokens(text):
    """Lowercase, fold accents, and split into alphanumeric tokens."""
    import unicodedata  # lazy: only identifier checks need it

    folded = "".join(c for c in unicodedata.normalize("NFKD", str(text)) if not unicodedata.combining(c))
    return re.findall(r"[^\W_]+", folded.lower())


def id_hash(salt, entry):
    import hashlib  # lazy: only identifier checks need it

    return hashlib.sha256(bytes.fromhex(salt) + b"\0" + entry.encode("utf-8")).hexdigest()[:HASH_WIDTH]


# A present but malformed index: every lookup matches, so callers fail closed.
INVALID_INDEX = ("", HASH_WIDTH, "")


def read_index(path):
    """(salt, width, sorted hash blob) from an index file, None when absent, INVALID_INDEX when malformed."""
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (FileNotFoundError, NotADirectoryError):
        return None
    except (OSError, ValueError):
        return INVALID_INDEX
    if not isinstance(data, dict):
        return INVALID_INDEX
    salt, width, blob = data.get("salt"), data.get("width"), data.get("hashes")
    if (not isinstance(salt, str) or not re.fullmatch(r"[0-9a-f]{32,128}", salt) or type(width) is not int
            or width != HASH_WIDTH or not isinstance(blob, str) or len(blob) % width
            or data.get("count") != len(blob) // width or blob != blob.lower()):
        return INVALID_INDEX
    try:
        if len(bytes.fromhex(blob)) * 2 != len(blob):  # fromhex skips whitespace
            return INVALID_INDEX
    except ValueError:
        return INVALID_INDEX
    count = len(blob) // width  # binary search needs sorted keys: check all, or 4096 evenly spaced
    keys = [blob[i * width:(i + 1) * width] for i in range(0, count, max(1, count // 4096))] + [blob[-width:]]
    if any(a >= b for a, b in zip(keys, keys[1:-1])) or (count > 1 and keys[-2] > keys[-1]):
        return INVALID_INDEX
    return salt, width, blob


def _indexed(index, entry):
    if index is INVALID_INDEX:
        return True
    salt, width, blob = index
    key = id_hash(salt, entry)[:width]
    lo, hi = 0, len(blob) // width
    while lo < hi:
        mid = (lo + hi) // 2
        probe = blob[mid * width:(mid + 1) * width]
        if probe == key:
            return True
        if probe < key:
            lo = mid + 1
        else:
            hi = mid
    return False


def index_hit(text, index):
    """True when any 1-3 token n-gram (single tokens only if ID-like) or the whole text is in the index."""
    if index is INVALID_INDEX:
        return True
    tokens = id_tokens(text)
    grams = {" ".join(tokens)} if len(tokens) > 3 else set()
    for size in (1, 2, 3):
        for start in range(len(tokens) - size + 1):
            gram = tokens[start:start + size]
            if size == 1 and (len(gram[0]) < 4 or not any(ch.isdigit() for ch in gram[0])):
                continue
            grams.add(" ".join(gram))
    return any(_indexed(index, gram) for gram in grams)
# --- end identifier index ---

INDEX_REL = os.path.join(".methodsmith", "identifier-index.local.json")
CONFIG_REL = os.path.join(".methodsmith", "config.local.yaml")
DELIMITED = {".csv": ",", ".tsv": "\t", ".tab": "\t", ".psv": "|"}
ARROW = (".parquet", ".feather", ".arrow")
def entries_for(kind, value):
    tokens = id_tokens(value)
    if not tokens:
        return
    if len(tokens) >= 2:
        yield " ".join(tokens)
        if kind == "name":
            yield f"{tokens[0]} {tokens[-1]}"
            yield f"{tokens[-1]} {tokens[0]}"
    if kind == "id":
        for token in tokens:
            if len(token) >= 4 and any(ch.isdigit() for ch in token):
                yield token


def row_entries(kinds, row):
    firsts, lasts = [], []
    for kind, value in zip(kinds, row):
        if kind is None or value is None or str(value).strip() == "":
            continue
        if kind == "first":
            firsts.extend(id_tokens(value)[:1])
        elif kind == "last":
            lasts.extend(id_tokens(value)[-1:])
        else:
            yield from entries_for(kind, value)
    for first in firsts:
        for last in lasts:
            yield f"{first} {last}"
            yield f"{last} {first}"


def scan_delimited(path, delimiter, entries):
    opener = gzip.open if path.lower().endswith(".gz") else open
    with opener(path, "rt", encoding="utf-8-sig", errors="replace", newline="") as fh:
        reader = csv.reader(fh, delimiter=delimiter)
        header = next(reader, None) or []
        kinds = [header_kind(h) for h in header]
        if not any(kinds):
            return 0
        for row in reader:
            entries.update(row_entries(kinds, row))
    return sum(1 for k in kinds if k)


def scan_arrow(path, entries):
    try:
        import pyarrow.feather as feather
        import pyarrow.parquet as pq
    except ImportError:
        return None
    if path.lower().endswith(".parquet"):
        names = pq.ParquetFile(path).schema_arrow.names
        read = lambda cols: pq.read_table(path, columns=cols)  # noqa: E731
    else:
        names = feather.read_table(path).schema.names
        read = lambda cols: feather.read_table(path, columns=cols)  # noqa: E731
    kinds = [header_kind(n) for n in names]
    columns = [n for n, k in zip(names, kinds) if k]
    if not columns:
        return 0
    table = read(columns)
    kept = [k for k in kinds if k]
    for row in zip(*(table.column(c).to_pylist() for c in columns)):
        entries.update(row_entries(kept, row))
    return len(columns)


def git_main(top):
    try:
        out = subprocess.run(["git", "-C", top, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    common = out.stdout.strip()
    return os.path.dirname(common.rstrip(os.sep)) if out.returncode == 0 and common.endswith(".git") else None


def project_root(start):
    probe = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(probe, ".methodsmith")) or os.path.exists(os.path.join(probe, ".git")):
            return probe
        parent = os.path.dirname(probe)
        if parent == probe:
            return os.path.abspath(start)
        probe = parent


def configured_data_root(root):
    candidates = [root] + [m for m in [git_main(root)] if m and m != root]
    for base in candidates:
        try:
            with open(os.path.join(base, CONFIG_REL), encoding="utf-8") as fh:
                for line in fh:
                    match = re.match(r"^\s*data_root:\s*(.*)$", line)
                    if match:
                        value = match.group(1).split(" #", 1)[0].strip().strip("'\"")
                        if value and value.lower() not in ("null", "~"):
                            value = os.path.expanduser(value)
                            return value if os.path.isabs(value) else os.path.join(base, value)
        except OSError:
            continue
    return None


def ensure_ignored(root, pattern, probe):
    """Append pattern to the project's .gitignore unless git already ignores probe."""
    try:
        check = subprocess.run(["git", "-C", root, "check-ignore", "-q", probe], capture_output=True, timeout=5)
        if check.returncode in (0, 128):  # ignored, or not a git repository
            return
    except (OSError, subprocess.SubprocessError):
        pass
    path = os.path.join(root, ".gitignore")
    try:
        with open(path, encoding="utf-8") as fh:
            current = fh.read()
    except OSError:
        current = ""
    if pattern in current.splitlines():
        return
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(("" if not current or current.endswith("\n") else "\n") + pattern + "\n")


LEGACY_STATE_DIR = ".ce-datascience"  # rebrand:keep


def legacy_state_root(start):
    """The nearest project folder holding only the pre-rename state folder, or None."""
    probe = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(probe, ".methodsmith")):
            return None
        if os.path.isdir(os.path.join(probe, LEGACY_STATE_DIR)):
            return probe
        if os.path.exists(os.path.join(probe, ".git")):
            return None
        parent = os.path.dirname(probe)
        if parent == probe:
            return None
        probe = parent


def legacy_refusal(tool, start):
    """Refuse (exit 2) instead of running without the project's boundary settings."""
    legacy = legacy_state_root(start)
    if not legacy:
        return None
    print(f"{tool}: {legacy} still uses the pre-rename state folder {LEGACY_STATE_DIR}/, which is no longer "
          f"read. Move it with `mv {LEGACY_STATE_DIR} .methodsmith` (or run method-update), then retry.")
    return 2


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    refused = legacy_refusal("method-identifier-index", os.getcwd())
    if refused:
        return refused
    root = project_root(os.getcwd())
    data_root = None
    if "--data-root" in argv and argv.index("--data-root") + 1 < len(argv):
        data_root = os.path.abspath(os.path.expanduser(argv[argv.index("--data-root") + 1]))
    data_root = data_root or configured_data_root(root)
    if not data_root or not os.path.isdir(data_root):
        print("method-identifier-index: no data_root directory is configured; nothing indexed.")
        return 0
    entries, files, columns, skipped = set(), 0, 0, 0
    for dirpath, dirnames, filenames in os.walk(data_root):
        dirnames.sort()
        for name in sorted(filenames):
            path = os.path.join(dirpath, name)
            lower = name.lower()
            base = lower[:-3] if lower.endswith(".gz") else lower
            ext = os.path.splitext(base)[1]
            try:
                if ext in DELIMITED:
                    found = scan_delimited(path, DELIMITED[ext], entries)
                elif lower.endswith(ARROW):
                    found = scan_arrow(path, entries)
                else:
                    continue
            except Exception:  # never echo file bytes from an error message
                skipped += 1
                continue
            if found is None:
                skipped += 1
                continue
            if found:
                files += 1
                columns += found
    salt = secrets.token_hex(16)
    hashes = "".join(sorted({id_hash(salt, e) for e in entries}))
    index = {"version": 1, "salt": salt, "width": HASH_WIDTH, "count": len(hashes) // HASH_WIDTH, "hashes": hashes}
    out_path = os.path.join(root, INDEX_REL)
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    tmp = out_path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(index, fh)
    os.replace(tmp, out_path)
    ensure_ignored(root, ".methodsmith/identifier-index.local.json", ".methodsmith/identifier-index.local.json")
    note = f"; {skipped} files skipped (unreadable, or Parquet/Feather without pyarrow)" if skipped else ""
    print(f"method-identifier-index: {files} files, {columns} identifier columns, {index['count']} entries"
          f" -> {INDEX_REL}{note}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
