#!/usr/bin/env bash
# methodsmith environment health check
# Outputs a formatted diagnostic report for R/Python data science tooling

set -o pipefail

# =====================================================
#  Dependency config
# =====================================================
# Format: name|check_cmd|tier|install_cmd|url
# Tiers: recommended (flagged if missing), optional (noted if missing)

deps=(
  "R|R --version|recommended|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q r|https://cran.r-project.org"
  "python3|python3 --version|recommended|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q python|https://www.python.org/downloads/"
  "uv|command -v uv|optional|python3 -m pip install --user uv|https://docs.astral.sh/uv/getting-started/installation/"
  "quarto|quarto --version|optional|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q quarto|https://quarto.org/docs/get-started/"
  "jq|command -v jq|recommended|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q jq|https://jqlang.github.io/jq/"
  "gh|command -v gh|optional|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q gh|https://cli.github.com"
  "git|command -v git|optional|NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew install -q git|https://git-scm.com"
)

# =====================================================
#  Args
# =====================================================

plugin_version=""
locked_down="no"
while [ $# -gt 0 ]; do
  case "$1" in
    --version) [ -n "$2" ] && plugin_version="$2" && shift 2 || shift ;;
    --locked-down|--no-install) locked_down="yes"; shift ;;
    *) shift ;;
  esac
done

# =====================================================
#  Helpers
# =====================================================

ok()      { echo "  🟢  $1"; }
fail()    { echo "  🔴  $1"; }
warn()    { echo "  🟡  $1"; }
skip()    { echo "  ➖  $1"; }
detail()  { echo "       $1"; }
section() { echo ""; echo " $1"; }

has_brew=$(command -v brew >/dev/null 2>&1 && echo "yes" || echo "no")
in_repo=$(git rev-parse --is-inside-work-tree >/dev/null 2>&1 && echo "yes" || echo "no")

has_legacy_codex_tool_map() {
  awk '
    { sub(/\r$/, "") }
    $0 == "<!-- BEGIN COMPOUND CODEX TOOL MAP -->" { seen = 1 }
    seen && $0 == "<!-- END COMPOUND CODEX TOOL MAP -->" { found = 1; exit }
    END { exit found ? 0 : 1 }
  ' "$1"
}

codex_agents_file="${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
legacy_codex_tool_map="no"
if [ -f "$codex_agents_file" ] && has_legacy_codex_tool_map "$codex_agents_file"; then
  legacy_codex_tool_map="yes"
fi

# =====================================================
#  Check tools
# =====================================================

cli_ok=0; cli_total=0; issues=0

results=()
for entry in "${deps[@]}"; do
  IFS='|' read -r name check_cmd tier install_cmd url < <(printf '%s\n' "$entry")
  cli_total=$((cli_total + 1))
  if eval "$check_cmd" >/dev/null 2>&1; then
    cli_ok=$((cli_ok + 1))
    results+=("$name|$tier|ok|$install_cmd|$url")
  else
    results+=("$name|$tier|missing|$install_cmd|$url")
  fi
done

# =====================================================
#  Project checks (repo only)
# =====================================================

repo_cfg_gitignore="skip"
config_exists="skip"
legacy_state="no"

if [ "$in_repo" = "yes" ]; then
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)

  if [ -d "$repo_root/.ce-datascience" ]; then  # rebrand:keep
    legacy_state="yes"
  fi

  if [ -f "$repo_root/.methodsmith/config.local.yaml" ]; then
    config_exists="ok"
    if git check-ignore -q "$repo_root/.methodsmith/config.local.yaml" 2>/dev/null; then
      repo_cfg_gitignore="ok"
    else
      repo_cfg_gitignore="missing"
    fi
  else
    config_exists="missing"
  fi
fi

# =====================================================
#  Output
# =====================================================

echo ""
if [ -n "$plugin_version" ]; then
  ok "Plugin version v${plugin_version}"
fi

# --- Tools ---

section "Tools  ${cli_ok}/${cli_total}"

for result in "${results[@]}"; do
  IFS='|' read -r name tier status install_cmd url < <(printf '%s\n' "$result")
  if [ "$status" = "ok" ]; then
    ok "$name"
  else
    if [ "$tier" = "optional" ]; then
      warn "$name (optional)"
      detail "$url"
    else
      warn "$name"
      issues=$((issues + 1))
      if [ "$locked_down" = "yes" ]; then
        detail "locked-down mode: no install command offered; ask IT or use an approved local runtime"
        detail "$url"
      else
        case "$install_cmd" in
          *brew\ install*)
            if [ "$has_brew" = "yes" ]; then detail "$install_cmd"
            else detail "$url"; fi ;;
          *)
            detail "$install_cmd"
            detail "$url" ;;
        esac
      fi
    fi
  fi
done

# --- Codex instructions ---

if [ "$legacy_codex_tool_map" = "yes" ]; then
  section "Codex instructions"
  warn "Legacy Compound Codex tool map in ${codex_agents_file}"
  detail "Retired pre-native-install block; remove it only after reviewing references/legacy-codex-tool-map.md."
  detail "Re-running the methodsmith Codex installer for this CODEX_HOME replaces it with the current CE block."
  issues=$((issues + 1))
fi

# --- Project ---

if [ "$in_repo" = "yes" ]; then
  has_project_issues="no"

  if [ "$config_exists" = "missing" ]; then
    has_project_issues="yes"
  fi
  if [ "$repo_cfg_gitignore" = "missing" ]; then
    has_project_issues="yes"
  fi

  if [ "$legacy_state" = "yes" ]; then
    has_project_issues="yes"
  fi

  if [ "$has_project_issues" = "yes" ]; then
    section "Project"

    if [ "$legacy_state" = "yes" ]; then
      if [ -d "$repo_root/.methodsmith" ]; then
        warn "Both .ce-datascience and .methodsmith exist; only .methodsmith sets the mode. Compare the two config.local.yaml files, keep what you need in .methodsmith, then remove .ce-datascience"  # rebrand:keep
      else
        warn "Pre-rename state folder found; move it: mv .ce-datascience .methodsmith (the guard runs schema-only until then)"  # rebrand:keep
      fi
      issues=$((issues + 1))
    fi

    if [ "$config_exists" = "missing" ]; then
      warn "Stack profile not configured (.methodsmith/config.local.yaml)"
      issues=$((issues + 1))
    fi

    if [ "$repo_cfg_gitignore" = "missing" ]; then
      warn "Local config not safely gitignored"
      issues=$((issues + 1))
    fi
  fi
fi

# --- Bottom line ---

echo ""
if [ "$issues" -eq 0 ]; then
  echo " ✅  All clear  ${cli_ok}/${cli_total} tools"
else
  echo " ⚠️   ${issues} issue(s) found  ${cli_ok}/${cli_total} tools"
fi

echo ""
