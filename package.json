{
  "name": "methodsmith",
  "version": "5.1.0",
  "description": "Methodsmith plugin for Claude Code, Codex, and Pi — agentic workflows for computational science, statistical review, and reporting compliance",
  "type": "module",
  "private": false,
  "bin": {
    "methodsmith": "src/index.ts"
  },
  "homepage": "https://github.com/sajor2000/methodsmith",
  "repository": "https://github.com/sajor2000/methodsmith",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "convert": "bun run src/index.ts convert",
    "list": "bun run src/index.ts list",
    "cli:install": "bun run src/index.ts install",
    "package:corporate": "bash scripts/package/corporate-artifacts.sh",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "release:preview": "bun run scripts/release/preview.ts",
    "release:sync-metadata": "bun run scripts/release/sync-metadata.ts --write",
    "release:validate": "bun run scripts/release/validate.ts",
    "plugin:validate": "claude plugin validate .claude-plugin/marketplace.json && claude plugin validate plugins/methodsmith",
    "eval:validate": "bun run scripts/evals/validate.ts",
    "eval:prepare": "bun run scripts/evals/prepare.ts",
    "eval:score": "bun run scripts/evals/score.ts",
    "eval:report": "bun run scripts/evals/report.ts",
    "docs:guideline-sources": "bun run scripts/docs/guideline-sources.ts",
    "legacy:fingerprints": "bun run scripts/maintenance/description-fingerprints.ts",
    "rebrand": "bun run scripts/rebrand/rename.ts"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@davisvaughan/tree-sitter-r": "1.3.0",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.0.0",
    "tree-sitter-python": "0.25.0",
    "typescript": "^5.9.3",
    "web-tree-sitter": "0.27.1"
  }
}
